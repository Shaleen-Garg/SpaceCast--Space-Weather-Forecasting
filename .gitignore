# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Build / Distribution ─────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Secrets / environment files ───────────────────────────────────────────────
.env
.env.*
*.env
secrets.yaml
secrets.json

# ── Data — raw datasets (must be downloaded separately) ──────────────────────
# Obtain OMNI2 data from: https://omniweb.gsfc.nasa.gov/
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ── Model weights & checkpoints ───────────────────────────────────────────────
# TimesFM and Chronos weights must be downloaded separately.
# See notebooks/04_chronos_forecasting.ipynb for setup instructions.
# NOTE: /models/ ignores only the top-level models/ dir (downloaded weights),
#       NOT src/spacecast/models/ which is tracked source code.
/models/
*.bin
*.pt
*.ckpt
*.safetensors

# ── Pickle / intermediate outputs ─────────────────────────────────────────────
*.pkl
*.pickle

# ── HuggingFace & PyTorch caches ─────────────────────────────────────────────
.cache/
hf_cache/
huggingface_cache/
torch_cache/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── OS metadata ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / editor files ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
